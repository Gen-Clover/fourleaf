# MongoDB connection string, including the database name. Must be a replica set (Atlas always is).
# Atlas: create the cluster in Mumbai (ap-south-1) for the lowest latency from India.
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/genclover?retryWrites=true&w=majority"
# Local development instead (run `npm run db:local` in its own terminal):
# DATABASE_URL="mongodb://127.0.0.1:27017/genclover?replicaSet=rs0&directConnection=true"
AUTH_SECRET="replace-with-a-long-random-string"
SEED_ADMIN_EMAIL="admin@genclover.local"
SEED_ADMIN_PASSWORD="ChangeMe@2026"

# Lead Finder: a Google Cloud API key with "Places API (New)" and "PageSpeed Insights API" enabled.
# Restrict it to those two APIs. Spend is capped under Lead Finder → Settings.
GOOGLE_MAPS_API_KEY=""

# Lead Finder email (optional). Use a separate sending domain or mailbox for outreach, e.g. hello@mail.genclover.com.
# Gmail / Google Workspace: smtp.gmail.com, port 587, an App Password; IMAP imap.gmail.com.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Your Name at Gen Clover <hello@mail.genclover.com>"
# Reply, unsubscribe and bounce checking (defaults to the SMTP host and login when empty)
IMAP_HOST=""
IMAP_PORT="993"
