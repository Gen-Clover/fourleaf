# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any workspace)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# Any database file or export holds client and salary data — never commit (incl. backups anywhere)
*.db
*.db-journal
data-export/

# Editor / OS
.vscode/
.idea/
Thumbs.db

# Local MongoDB data (npm run db:local)
.mongo-data/

# local notes (test logins etc.)
*.local.md
