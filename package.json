{
  "name": "genclover-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Gen Clover internal portal: one app hosting every internal tool (finance, lead finder, ...)",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n portal,worker -c red,blue \"npm run dev -w @genclover/portal\" \"npm run dev -w @genclover/workers\"",
    "build": "npm run build -w @genclover/portal",
    "start": "npm run start -w @genclover/portal",
    "lint": "eslint apps tools packages",
    "typecheck": "npm run typecheck -w @genclover/portal",
    "db:generate": "npm run generate -w @genclover/db",
    "db:push": "npm run push -w @genclover/db && npm run backfill -w @genclover/ids",
    "db:seed": "npm run seed -w @genclover/db",
    "setup": "npm run db:push && npm run db:seed",
    "db:migrate-sqlite": "npm run migrate:sqlite -w @genclover/db --",
    "db:local": "npm run local -w @genclover/db",
    "dev:portal": "npm run dev -w @genclover/portal",
    "worker": "npm run start -w @genclover/workers"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
