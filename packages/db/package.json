{
  "name": "@genclover/db",
  "version": "0.1.0",
  "private": true,
  "description": "Shared MongoDB schema and Prisma client for every portal tool",
  "exports": {
    ".": "./src/index.ts",
    "./audit": "./src/audit.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "push": "prisma db push --skip-generate && tsx scripts/after-push.ts",
    "seed": "prisma db seed",
    "setup": "npm run push && npm run seed",
    "migrate:sqlite": "tsx scripts/migrate-from-sqlite.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "prisma": "^6.19.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
