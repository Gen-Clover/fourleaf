// Shared tables used by every tool: users, settings, clients, audit log.
// Database: MongoDB. IDs are cuid strings stored as _id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Role: OWNER | CFO | SALES | ONBOARDING | DELIVERY | TEAM (packages/auth/src/access.ts)
model User {
  id           String     @id @default(cuid()) @map("_id")
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("TEAM")
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  projects     Project[]
}

/// Editable formula parameters (FX, hours, load factor, floor rule, packages...)
model Setting {
  key         String   @id @map("_id")
  value       String
  label       String
  group       String
  type        String   @default("number") // number | text
  unit        String?
  description String?
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Client {
  id               String          @id @default(cuid()) @map("_id")
  number           String          @unique // Client ID, GC-YYYY-NNNN (system, never changes)
  code             String          @unique // Client code, e.g. ABR (chosen at onboarding, then locked): project IDs, Jira, folders, emails
  name             String
  contactName      String?
  email            String?
  phone            String?
  country          String?         @default("USA")
  city             String?
  timezone         String?
  website          String?
  billingAddress   String?
  notes            String?
  // Tax and billing (India GST; export clients bill in USD under LUT)
  legalName        String?
  gstin            String?
  pan              String?
  state            String? // Indian state for place of supply, e.g. Punjab
  currency         String          @default("USD") // INR | USD
  paymentTermsDays Int?
  industry         String?
  // Onboarding (Clients & Agreements tool). status: ONBOARDING | ACTIVE | INACTIVE
  status           String          @default("ACTIVE")
  onboardedAt      DateTime?
  accountManager   String?
  checklist        String? // JSON { itemKey: true }
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  projects         Project[]
  invoices         Invoice[]
  leads            Lead[]
  contacts         ClientContact[]
  agreements       Agreement[]
  opportunities    Opportunity[]
}

model AuditLog {
  id        String   @id @default(cuid()) @map("_id")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Named counters for readable IDs (packages/ids). key examples: "client:2026", "project:<clientId>",
/// "invoice:GCI/26-27", "lead:2026-09". value = the last number handed out.
model Sequence {
  key   String @id @map("_id")
  value Int
}

/// Background work for apps/workers (searches, website audits…). Any tool can add a job type.
/// status: QUEUED | RUNNING | DONE | FAILED | PAUSED | CANCELLED. group ties a job to its parent (e.g. a search).
model Job {
  id         String    @id @default(cuid()) @map("_id")
  type       String
  payload    String // JSON
  group      String?
  status     String    @default("QUEUED")
  attempts   Int       @default(0)
  runAfter   DateTime  @default(now())
  lockedAt   DateTime?
  error      String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([status, runAfter])
  @@index([group, status])
}

/// Small pieces of system state (e.g. the last email checked in the inbox). Not user settings.
model SystemState {
  key       String   @id @map("_id")
  value     String
  updatedAt DateTime @updatedAt
}

/// Paid API calls per month (key = "YYYY-MM:SKU"), for spend estimates and monthly caps.
model ApiUsage {
  key   String @id @map("_id")
  count Int    @default(0)
}
