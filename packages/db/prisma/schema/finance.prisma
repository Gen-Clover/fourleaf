// Finance tool: rate card, projects, delivery, invoicing, expenses, treasury.
// Defaults come from docs/finance/Gen-Clover-Rate-Card-2026.md (seeded via prisma/seed.ts).

/// Revenue allocation buckets (65 / 10 / 25 model). Must total 100%.
model AllocationBucket {
  id          String  @id @default(cuid()) @map("_id")
  key         String  @unique
  name        String
  percent     Float
  category    String // DELIVERY | GROWTH | CORPORATE
  isProfit    Boolean @default(false)
  description String?
  sortOrder   Int     @default(0)
}

/// Rate card (one row per role / domain)
model RoleRate {
  id           String            @id @default(cuid()) @map("_id")
  name         String            @unique
  family       String
  marketMin    Float
  marketMax    Float
  usSalary     Float
  standardRate Float
  floorRate    Float? // null = computed by floor rule
  ctcMinL      Float? // India CTC, ₹ lakh / yr
  ctcMaxL      Float?
  notes        String?
  active       Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  resources    ProjectResource[]
  people       Person[]
}

/// status: DRAFT | QUOTED | NEGOTIATION | ACTIVE | ON_HOLD | COMPLETED | CANCELLED
/// engagementModel: TM | RETAINER | BLENDED | FIXED (monthly fee) | FIXED_PRICE (one price, billed by milestones)
/// kind: PROJECT | CARE (support after go-live) | PRODUCT (Gen Clover's own product) | INTERNAL (bench, R&D, admin)
model Project {
  id                 String            @id @default(cuid()) @map("_id")
  code               String            @unique // <client code>-P01, e.g. ABR-P01 (packages/ids)
  kind               String            @default("PROJECT")
  name               String
  clientId           String
  client             Client            @relation(fields: [clientId], references: [id])
  status             String            @default("DRAFT")
  engagementModel    String            @default("TM")
  currency           String            @default("USD") // client billing currency: USD | INR
  opportunityId      String?
  deliveryManager    String?
  startDate          DateTime?
  endDate            DateTime?
  description        String?
  // Sales pipeline (Draft / Quoted / Negotiation)
  probability        Int? // % chance of closing
  expectedCloseDate  DateTime?
  // Agreement (what was finally agreed with the client)
  agreedAt           DateTime?
  agreedMonthly      Float? // RETAINER / FIXED monthly amount
  agreedBlendedRate  Float? // BLENDED
  agreedRetainerHrs  Float? // RETAINER included hours
  agreedExtraRate    Float? // RETAINER additional hours rate
  agreementNotes     String?
  // JSON snapshot of allocation buckets at creation (rate-card changes don't rewrite history)
  allocationSnapshot String
  createdById        String?
  createdBy          User?             @relation(fields: [createdById], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  resources          ProjectResource[]
  months             MonthlyRecord[]
  milestones         Milestone[]
  assignments        Assignment[]
  timeEntries        TimeEntry[]
  expenses           Expense[]
  invoices           Invoice[]
  agreements         Agreement[]
  workOrders         WorkOrder[]
  resourceRequests   ResourceRequest[]
  issues             Issue[]

  @@index([clientId])
}

/// tier: STANDARD | FLOOR | PREMIUM | CUSTOM
model ProjectResource {
  id            String        @id @default(cuid()) @map("_id")
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleId        String?
  role          RoleRate?     @relation(fields: [roleId], references: [id])
  label         String
  headcount     Int           @default(1)
  hoursPerMonth Float
  tier          String        @default("STANDARD")
  quotedRate    Float
  agreedRate    Float?
  standardRate  Float // snapshot
  floorRate     Float // snapshot
  sortOrder     Int           @default(0)
  lines         MonthlyLine[]
  assignments   Assignment[]

  @@index([projectId])
}

/// status: DRAFT | INVOICED | PAID — synced from the linked invoice
model MonthlyRecord {
  id         String        @id @default(cuid()) @map("_id")
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  month      String // YYYY-MM
  status     String        @default("DRAFT")
  hours      Float         @default(0) // computed on save
  revenue    Float         @default(0) // computed on save
  adjustment Float         @default(0)
  invoiceId  String?
  invoice    Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  lines      MonthlyLine[]

  @@unique([projectId, month])
  @@index([invoiceId])
}

model MonthlyLine {
  id         String           @id @default(cuid()) @map("_id")
  recordId   String
  record     MonthlyRecord    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  resourceId String?
  resource   ProjectResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  label      String
  hours      Float
  rate       Float

  @@index([recordId])
}

/// type: EMPLOYEE | CONTRACTOR · costBasis: MONTHLY (₹ per month, e.g. CTC ÷ 12) | HOURLY (₹ per hour)
/// payModel: SALARY (employee, monthly) | HOURLY (approved hours × rate) | RETAINER (fixed monthly fee for
/// capacity) | FIXED_FEE (paid per work order). costInr = monthly salary / retainer, or the hourly rate.
model Person {
  id               String           @id @default(cuid()) @map("_id")
  code             String? // GCE-0001 employee, GCT-0001 contractor (unique when set: scripts/after-push.ts)
  name             String
  email            String?
  phone            String?
  title            String?
  department       String?
  managerName      String?
  type             String           @default("EMPLOYEE")
  payModel         String           @default("SALARY")
  pan              String?
  gstin            String?
  gstRegistered    Boolean          @default(false) // contractor charges GST on their invoice
  tdsRatePct       Float? // TDS deducted on contractor payments (e.g. 10 for 194J); null = settings default
  onboarding       String? // JSON checklist { key: true }
  offboarding      String?
  roleId           String?
  role             RoleRate?        @relation(fields: [roleId], references: [id])
  costBasis        String           @default("MONTHLY")
  costInr          Float            @default(0)
  stdHoursPerMonth Float            @default(160)
  startDate        DateTime?
  endDate          DateTime?
  nextReviewDate   DateTime? // salary review / hike due
  active           Boolean          @default(true)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  assignments      Assignment[]
  timeEntries      TimeEntry[]
  milestones       Milestone[]
  expenses         Expense[]
  documents        PersonDocument[]
  workOrders       WorkOrder[]
  timesheetWeeks   TimesheetWeek[]
  payLines         PayLine[]
}

/// A person staffed on a project, optionally against one resource line of the quote.
model Assignment {
  id            String           @id @default(cuid()) @map("_id")
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personId      String
  person        Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  resourceId    String?
  resource      ProjectResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  hoursPerMonth Float            @default(0)
  billable      Boolean          @default(true)
  // What the client is billed for this person's time (finance only): ACTUAL = hours worked;
  // PER_DAY = billValue hours for every day worked (e.g. 8); FACTOR = hours worked × billValue.
  billMode      String           @default("ACTUAL")
  billValue     Float            @default(1)
  startDate     DateTime?
  endDate       DateTime?

  @@unique([projectId, personId])
  @@index([personId])
}

/// status: PLANNED | IN_PROGRESS | DONE | BLOCKED
model Milestone {
  id            String    @id @default(cuid()) @map("_id")
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  notes         String?
  ownerId       String?
  owner         Person?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  dueDate       DateTime?
  status        String    @default("PLANNED")
  completedAt   DateTime?
  // Fixed-price billing (finance only): the amount billed when the milestone is delivered
  billingAmount Float?
  invoiceId     String?
  acceptedAt    DateTime?
  acceptanceRef String? // acceptance certificate code, e.g. ABR-P01-AC01
  sortOrder     Int       @default(0)

  @@index([projectId])
}

/// One person, one project, one day. costRateInr is snapshotted so salary changes never rewrite history.
model TimeEntry {
  id          String   @id @default(cuid()) @map("_id")
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime
  hours       Float // worked: what the person is paid for (hourly people)
  billedHours Float? // billed to the client (null = hours); from the assignment's billing basis
  billable    Boolean  @default(true)
  costRateInr Float    @default(0)
  createdAt   DateTime @default(now())

  @@unique([personId, projectId, date, billable])
  @@index([projectId, date])
}

/// bucketKey links spend to an AllocationBucket (budget vs actual). null = client pass-through (outside the 65/10/25 model).
model ExpenseCategory {
  id        String    @id @default(cuid()) @map("_id")
  name      String    @unique
  bucketKey String?
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  expenses  Expense[]
}

/// currency: INR | USD. amountInr = amount × fxRate (fxRate 1 for INR). paidOn null = unpaid (payable).
model Expense {
  id           String          @id @default(cuid()) @map("_id")
  date         DateTime
  vendor       String
  description  String?
  categoryId   String
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  currency     String          @default("INR")
  amount       Float
  fxRate       Float           @default(1)
  amountInr    Float
  gstInr       Float           @default(0) // input GST, tracked apart from cost
  projectId    String?
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  personId     String?
  person       Person?         @relation(fields: [personId], references: [id], onDelete: SetNull)
  payrollMonth String? // YYYY-MM when generated by a payroll run
  passThrough  Boolean         @default(false) // re-billable to the client at cost
  paidOn       DateTime?
  reference    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  // At most one line: enforced by the partial unique index in scripts/ensure-indexes.ts
  invoiceLines InvoiceLine[]

  @@index([date])
  @@index([projectId])
}

/// status: DRAFT | SENT | PARTIAL | PAID | VOID. fxRate = ₹ per US$ used to book revenue on the issue date.
model Invoice {
  id            String          @id @default(cuid()) @map("_id")
  number        String          @unique
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id])
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  issueDate     DateTime
  dueDate       DateTime
  currency      String          @default("USD")
  fxRate        Float
  status        String          @default("DRAFT")
  total         Float           @default(0) // computed from lines on save, including tax
  // GST. taxType: NONE | EXPORT_LUT (export of services, zero-rated) | IGST (other state) | CGST_SGST (same state)
  taxType       String          @default("NONE")
  taxRate       Float           @default(0)
  subtotal      Float? // before tax (null on old invoices = total)
  taxAmount     Float           @default(0)
  placeOfSupply String?
  sac           String? // services accounting code, e.g. 998314
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  lines         InvoiceLine[]
  payments      Payment[]
  months        MonthlyRecord[]

  @@index([clientId])
  @@index([projectId])
}

/// kind: SERVICES | MILESTONE (fixed-price billing; revenue in the issue month) | PASS_THROUGH | OTHER
model InvoiceLine {
  id          String   @id @default(cuid()) @map("_id")
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind        String   @default("SERVICES")
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  amount      Float
  // Unique when set (an expense is billed once): partial unique index in scripts/ensure-indexes.ts.
  // Not @unique here, because MongoDB's plain unique index would allow only one line without an expense.
  expenseId   String?
  expense     Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  sortOrder   Int      @default(0)

  @@index([invoiceId])
}

/// amountUsd settles the invoice; inrReceived landed in the bank; bankChargesInr were deducted on the way.
/// Realised FX gain/loss = inrReceived + bankChargesInr − amountUsd × invoice.fxRate
model Payment {
  id             String      @id @default(cuid()) @map("_id")
  invoiceId      String
  invoice        Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date           DateTime
  amountUsd      Float // amount settled, in the invoice's currency (US$ or ₹)
  inrReceived    Float
  bankChargesInr Float       @default(0)
  tdsInr         Float       @default(0) // TDS the client deducted (Indian clients); claimable against our tax
  reference      String?
  createdAt      DateTime    @default(now())
  fundEntries    FundEntry[]

  @@index([invoiceId])
}

/// Movements into / out of a fund (fundKey = AllocationBucket.key, or "passthrough" for client pass-through clearing).
/// type: ALLOCATION (cash received, split by the active policy) | OPENING | TRANSFER | ADJUSTMENT.
/// Paid expenses are debited on the fly from the Expense table, so edits there never go out of sync.
model FundEntry {
  id         String   @id @default(cuid()) @map("_id")
  date       DateTime
  fundKey    String
  amountInr  Float // + in, − out
  type       String
  paymentId  String?
  payment    Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  transferId String? // pairs the two legs of a transfer
  policy     String? // name of the allocation policy used
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([fundKey, date])
  @@index([paymentId])
}

/// Future obligations. frequency: ONE_OFF | MONTHLY | QUARTERLY | YEARLY.
/// kind: CONTRACTOR | TAX | SUBSCRIPTION | RENT | LOAN | OTHER (payroll is derived from People).
/// essential = counts toward monthly unavoidable burn (runway).
model Commitment {
  id          String    @id @default(cuid()) @map("_id")
  name        String
  kind        String    @default("OTHER")
  fundKey     String
  amountInr   Float
  frequency   String    @default("MONTHLY")
  nextDueDate DateTime
  endDate     DateTime?
  essential   Boolean   @default(true)
  active      Boolean   @default(true)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Allocation policy by company stage. allocations = JSON [{ key, percent }]. Activating one writes it to AllocationBucket.
/// stage: STARTUP | GROWTH | MATURE | CUSTOM
model FinancialPolicy {
  id          String   @id @default(cuid()) @map("_id")
  name        String   @unique
  stage       String   @default("CUSTOM")
  description String?
  allocations String
  active      Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

/// A month's pay for everyone: PR-2026-10. status: DRAFT | APPROVED | PAID.
/// Approving writes each line as an expense (payroll or contractor payable); a second person approves.
model PayRun {
  id         String    @id @default(cuid()) @map("_id")
  code       String    @unique
  month      String // YYYY-MM
  status     String    @default("DRAFT")
  totalGross Float     @default(0)
  totalNet   Float     @default(0)
  createdBy  String
  approvedBy String?
  approvedAt DateTime?
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lines      PayLine[]

  @@index([month])
}

/// kind: SALARY | HOURLY | RETAINER | FIXED_FEE. breakdown = JSON [{ projectCode, hours, amount }].
/// gross − tds − otherDeductions + gst = net payable.
model PayLine {
  id              String    @id @default(cuid()) @map("_id")
  payRunId        String
  payRun          PayRun    @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  personId        String
  person          Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  kind            String
  description     String
  hours           Float     @default(0)
  rate            Float     @default(0)
  gross           Float
  gst             Float     @default(0)
  tds             Float     @default(0)
  otherDeductions Float     @default(0)
  net             Float
  breakdown       String?
  workOrderId     String?
  expenseId       String?
  paidOn          DateTime?
  reference       String?

  @@index([payRunId])
  @@index([personId])
}
